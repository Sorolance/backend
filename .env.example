# Local dev Postgres. Unix-socket connections need the socket dir
# percent-encoded as the host (sqlx's URL parser rejects a blank host even
# when a peer-auth role/database already exist locally):
DATABASE_URL=postgres://youruser@%2Fvar%2Frun%2Fpostgresql/rebalancer_dev

# --- rebalancer-scheduler (crates/scheduler) ---
# See PROJECT.md's testnet deployment table for the current addresses.
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VAULT_CONTRACT_ID=CC2PJBGDJOM4HNGDX5NJY4BNKQ2324PQSLWFDWXQDCFJ7AK6AIRLJ5AC
OWNER_ADDRESS=GB3GPOL22UTT4V7C2M6KUFM6IW4OHP6O6LHCH67LPIPTAKMYV7ZVYZX2
# `stellar keys` identity name (not a raw secret) that the vault's owner
# has authorized via `set_keeper` - see backend/README.md for how to
# provision one. Never a mainnet-relevant key for local/testnet dev.
KEEPER_IDENTITY=rebalancer-keeper
KEEPER_ADDRESS=GCDIR3ZXHY7VNUL35BWZMBWDSHGC6LW3E4PRHH6ONBJI3UJIX4QVSK6Q
ORACLE_ADAPTER_CONTRACT_ID=CA3RFMJ4BQ3G7OH5MJKZE56VCHY7NFQASAJN2CYNEZBM4NL76SNBBY5E
# Optional, all default sensibly - see crates/scheduler/src/config.rs:
# PORTFOLIO_NAME=Demo Portfolio
# THRESHOLD_BPS=500
# POLL_INTERVAL_SECS=300
# PRICE_DIVERGENCE_WARN_BPS=300
